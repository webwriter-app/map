        "iscedf2013-04",
        "iscedf2013-05",
        "iscedf2013-06",
        "iscedf2013-07",
        "iscedf2013-08",
        "iscedf2013-09",
        "iscedf2013-10",
        "isced2011-0",
        "isced2011-1",
        "isced2011-2",
        "isced2011-3",
        "geology",
        "map",
        "earth"
    ],
    "license": "MIT",
    "author": "Jorik van Genuchten",
    "contributors": [
        "Jorik van Genuchten"
    ],
    "scripts": {
        "prepublishOnly": "npx @webwriter/build"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.4.2",
        "@shoelace-style/shoelace": ">=2.4.0 <3.0.0-0",
